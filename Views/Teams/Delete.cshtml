@model VacationManager.Models.Team
@{
    ViewData["Title"] = "Изтриване на екип";
}
<h1>Изтриване на екип</h1>
<h4 class="text-danger">Сигурни ли сте, че искате да изтриете екипа „@Model.Name“?</h4>
<p class="text-muted">Членове: @Model.Members.Count</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
</form>
