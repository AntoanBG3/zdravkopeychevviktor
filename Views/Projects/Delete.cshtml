@model VacationManager.Models.Project
@{
    ViewData["Title"] = "Изтриване на проект";
}
<h1>Изтриване на проект</h1>
<h4 class="text-danger">Сигурни ли сте, че искате да изтриете проекта „@Model.Name“?</h4>
<p class="text-muted">Екипи по проекта: @Model.Teams.Count</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
</form>
