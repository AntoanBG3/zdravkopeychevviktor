@model VacationManager.Models.Project
@{
    var allTeams = (IEnumerable<VacationManager.Models.Team>)ViewBag.AllTeams;
    var teamIds = Model.Teams.Select(t => t.Id).ToHashSet();
    var availableTeams = allTeams.Where(t => !teamIds.Contains(t.Id));
    ViewData["Title"] = "Детайли за проект";
}
<h1>Проект: @Model.Name</h1>
<div class="card mb-3" style="max-width: 40rem;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Име</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Екипи</dt>
            <dd class="col-sm-9">@Model.Teams.Count</dd>
        </dl>
    </div>
</div>

<h4>Екипи по проекта</h4>
@if (Model.Teams.Count == 0)
{
    <p class="text-muted">Няма екипи, работещи по проекта.</p>
}
else
{
    <table class="table table-striped align-middle" style="max-width: 50rem;">
        <thead>
            <tr><th>Име</th><th>Лидер</th><th>Членове</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var team in Model.Teams)
            {
                <tr>
                    <td>@team.Name</td>
                    <td>@(team.Leader != null ? $"{team.Leader.FirstName} {team.Leader.LastName}" : "-")</td>
                    <td>@team.Members.Count</td>
                    <td class="text-end">
                        <form asp-action="RemoveTeam" asp-route-id="@Model.Id" asp-route-teamId="@team.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Премахни екип</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h4>Добави екип</h4>
@if (availableTeams.Any())
{
    <form asp-action="AddTeam" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end" style="max-width: 40rem;">
        <div class="col">
            <select name="teamId" class="form-select">
                @foreach (var team in availableTeams)
                {
                    <option value="@team.Id">@team.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Добави</button>
        </div>
    </form>
}
else
{
    <p class="text-muted">Всички екипи вече работят по проекта.</p>
}
<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Обратно</a>
</div>
