<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VacationManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">VacationManager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var user = Context.Items["CurrentUser"] as VacationManager.Models.User;
                    }
                    @if (user != null)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Начало</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Vacations" asp-action="Index">Моите заявки</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Vacations" asp-action="Create">Нова заявка</a></li>
                            @if (user.Role.Name == "CEO" || user.Role.Name == "Team Lead")
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Vacations" asp-action="Approve">За одобрение</a></li>
                            }
                            @if (user.Role.Name == "CEO")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" href="#">Управление</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Потребители</a></li>
                                        <li><a class="dropdown-item" asp-controller="Teams" asp-action="Index">Екипи</a></li>
                                        <li><a class="dropdown-item" asp-controller="Projects" asp-action="Index">Проекти</a></li>
                                        <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Роли</a></li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Потребители</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Teams" asp-action="Index">Екипи</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Projects" asp-action="Index">Проекти</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item"><span class="navbar-text me-2">@user.FirstName @user.LastName (@user.Role.Name)</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Изход</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1"></ul>
                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Вход</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VacationManager
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
