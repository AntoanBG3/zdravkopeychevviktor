<mxfile host="app.diagrams.net"><diagram name="ER диаграма – VacationManager (SQLite)" id="er"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="roles" value="&lt;b&gt;Roles&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  Id  INTEGER&lt;br&gt;UQ  Name  TEXT(50)  NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="230" height="81" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  Id  INTEGER&lt;br&gt;UQ  Username  TEXT(50)  NOT NULL&lt;br&gt;     PasswordHash  TEXT  NOT NULL&lt;br&gt;     FirstName  TEXT(50)  NOT NULL&lt;br&gt;     LastName  TEXT(50)  NOT NULL&lt;br&gt;FK  RoleId  INTEGER  NOT NULL&lt;br&gt;FK  TeamId  INTEGER  NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="280" height="176" as="geometry"/></mxCell><mxCell id="teams" value="&lt;b&gt;Teams&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  Id  INTEGER&lt;br&gt;UQ  Name  TEXT(100)  NOT NULL&lt;br&gt;FK  ProjectId  INTEGER  NULL&lt;br&gt;FK  LeaderId  INTEGER  NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="260" height="119" as="geometry"/></mxCell><mxCell id="projects" value="&lt;b&gt;Projects&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  Id  INTEGER&lt;br&gt;     Name  TEXT(100)  NOT NULL&lt;br&gt;     Description  TEXT(500)  NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="60" width="270" height="100" as="geometry"/></mxCell><mxCell id="vac" value="&lt;b&gt;VacationRequests&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK  Id  INTEGER&lt;br&gt;FK  RequesterId  INTEGER  NOT NULL&lt;br&gt;     Type  INTEGER  NOT NULL&lt;br&gt;CK  Type IN (0, 1, 2)&lt;br&gt;     FromDate  TEXT (дата)  NOT NULL&lt;br&gt;     ToDate  TEXT (дата)  NOT NULL&lt;br&gt;CK  ToDate &amp;gt;= FromDate&lt;br&gt;     CreatedOn  TEXT (дата)  NOT NULL&lt;br&gt;     HalfDay  INTEGER (0/1)  NOT NULL&lt;br&gt;     Approved  INTEGER (0/1)  NOT NULL&lt;br&gt;     SickNoteFileName  TEXT(200)  NULL&lt;br&gt;     SickNoteContentType  TEXT(200)  NULL&lt;br&gt;     SickNoteData  BLOB  NULL&lt;br&gt;CK  Type &amp;lt;&amp;gt; 2 OR (HalfDay = 0 AND SickNoteData IS NOT NULL)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="470" height="309" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;PK – първичен ключ     FK – външен ключ&lt;br&gt;UQ – уникален индекс     CK – CHECK ограничение&lt;br&gt;Връзка: черта = родител (1), пилешка лапа = много,&lt;br&gt;кръгче = незадължителна страна&lt;br&gt;&lt;br&gt;ON DELETE:&lt;br&gt;Users.RoleId – RESTRICT&lt;br&gt;Users.TeamId, Teams.ProjectId, Teams.LeaderId – SET NULL&lt;br&gt;VacationRequests.RequesterId – CASCADE&lt;br&gt;&lt;br&gt;CK ограниченията са предложение за миграцията&lt;br&gt;в Спринт 1; в момента правилата са в кода." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="380" width="470" height="271" as="geometry"/></mxCell><mxCell id="e0" value="RoleId (1 : N)" style="html=1;rounded=0;fontSize=11;startArrow=ERmandOne;startFill=0;e