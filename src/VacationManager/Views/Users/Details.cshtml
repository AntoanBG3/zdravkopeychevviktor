@model VacationManager.Models.User
@{
    ViewData["Title"] = "Детайли за потребител";
}
<h1>Детайли за потребител</h1>
<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Потребителско име</dt>
            <dd class="col-sm-8">@Model.Username</dd>
            <dt class="col-sm-4">Собствено име</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>
            <dt class="col-sm-4">Фамилия</dt>
            <dd class="col-sm-8">@Model.LastName</dd>
            <dt class="col-sm-4">Роля</dt>
            <dd class="col-sm-8">@Model.Role.Name</dd>
            <dt class="col-sm-4">Екип</dt>
            <dd class="col-sm-8">@(Model.Team?.Name ?? "-")</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Обратно</a>
</div>
