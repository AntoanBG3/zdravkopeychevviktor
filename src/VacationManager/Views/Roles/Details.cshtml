@model VacationManager.Models.Role
@{
    ViewData["Title"] = "Детайли за роля";
}
<h1>Роля: @Model.Name</h1>
<h4>Потребители с тази роля (@Model.Users.Count)</h4>
@if (Model.Users.Count == 0)
{
    <p class="text-muted">Няма потребители с тази роля.</p>
}
else
{
    <table class="table table-striped" style="max-width: 40rem;">
        <thead>
            <tr><th>Потребителско име</th><th>Име</th><th>Екип</th></tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.FirstName @user.LastName</td>
                    <td>@(user.Team?.Name ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Обратно</a>
</div>
