@model VacationManager.Models.Role
@{
    ViewData["Title"] = "Изтриване на роля";
}
<h1>Изтриване на роля</h1>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<h4 class="text-danger">Сигурни ли сте, че искате да изтриете ролята „@Model.Name“?</h4>
<p class="text-muted">Потребители с тази роля: @Model.Users.Count</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
</form>
